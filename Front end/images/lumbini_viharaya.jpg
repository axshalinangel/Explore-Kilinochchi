<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="bg_lumb" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#CA8A04"/>
      <stop offset="100%" stop-color="#713F12"/>
    </linearGradient>
    <radialGradient id="glow_lumb" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.45"/>
    </radialGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg_lumb)"/>
  <rect width="600" height="400" fill="url(#glow_lumb)"/>
  <circle cx="300" cy="160" r="75" fill="#ffffff" fill-opacity="0.18" stroke="#ffffff" stroke-width="2" stroke-opacity="0.4"/>
  <text x="300" y="188" font-size="64" text-anchor="middle" font-family="Segoe UI Emoji, Apple Color Emoji, sans-serif">☸️</text>
  <text x="300" y="275" font-size="23" font-weight="bold" fill="#ffffff" text-anchor="middle" font-family="Segoe UI, Montserrat, sans-serif">Kilinochchi Lumbini Viharaya</text>
  <text x="300" y="310" font-size="14" font-weight="600" fill="#fef08a" text-anchor="middle" font-family="Segoe UI, sans-serif" letter-spacing="1">BUDDHIST PEACE STUPA</text>
  <rect x="250" y="335" width="100" height="4" rx="2" fill="#ffffff" fill-opacity="0.5"/>
</svg>